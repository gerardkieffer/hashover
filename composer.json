{
    "name": "hashover/hashover",
    "description": "Self-hosted, privacy-friendly and accessible comment system for PHP websites",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.3"
    },
    "autoload": {
        "psr-4": {
            "HashOver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HashOver\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": ["@cs", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
