{#
 # A page's comment thread. Rendered inside <div id="hashover"> by the PHP
 # embed, or fetched and inserted by hashover.js.
 #
 # Variables: see HashOver\Application::context()
 #}
<section class="hashover-thread" aria-labelledby="hashover-heading" lang="{{ language }}"
    data-hashover-endpoint="{{ endpoint }}" data-hashover-url="{{ page.url }}" data-hashover-sort="{{ sort.value }}"
    data-hashover-text="{{ {
        confirmDelete: t('js.confirm_delete'),
        loading: t('js.loading'),
        failed: t('js.failed'),
        showImage: t('js.show_image'),
        image: t('js.image'),
    }|json_encode }}">
    <h2 id="hashover-heading" class="hashover-heading">{{ t('thread.heading') }}</h2>

    <div id="hashover-status" class="hashover-status" role="status" aria-live="polite" aria-atomic="true">
        {%- if message and message starts with 'message.' -%}
            <p>{{ t(message) }}</p>
        {%- endif -%}
    </div>

    {% include '_form.html.twig' with {kind: 'comment', target: null, form_id: 'hashover-form'} %}

    {% if is_logged_in %}
        {% include '_logout.html.twig' %}
    {% endif %}

    {% if view.popular is not empty %}
        <section class="hashover-popular" aria-labelledby="hashover-popular-heading">
            <h3 id="hashover-popular-heading">{{ t('thread.popular') }}</h3>
            <ol class="hashover-list">
                {% for node in view.popular %}
                    <li>{% include '_comment.html.twig' with {node: node, popular: true} %}</li>
                {% endfor %}
            </ol>
        </section>
    {% endif %}

    <section class="hashover-comments" aria-labelledby="hashover-comments-heading">
        <h3 id="hashover-comments-heading" tabindex="-1">{{ count_text }}</h3>

        {% if view.isEmpty() %}
            <p class="hashover-empty">{{ t('thread.empty') }}</p>
        {% else %}
            <nav class="hashover-sort" aria-label="{{ t('sort.label') }}">
                <span aria-hidden="true">{{ t('sort.label') }}:</span>
                <ul>
                    {% for option in sorts %}
                        <li>
                            <a href="{{ page.urlWith({hashover_sort: option.value}, 'hashover-comments-heading') }}"
                                data-hashover-sort="{{ option.value }}"
                                {%- if option == sort %} aria-current="true"{% endif %}>{{ t('sort.' ~ option.value) }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            <ol class="hashover-list">
                {% for node in view.comments %}
                    <li>{% include '_comment.html.twig' with {node: node, popular: false} %}</li>
                {% endfor %}
            </ol>
        {% endif %}
    </section>

    <footer class="hashover-footer">
        <ul>
            {% if not view.isEmpty() %}
                <li><a href="{{ rss_url }}" type="application/rss+xml">{{ t('footer.rss') }}</a></li>
            {% endif %}
            <li><a href="{{ config.sourceCodeUrl }}">{{ t('footer.source') }}</a></li>
        </ul>
    </footer>
</section>
